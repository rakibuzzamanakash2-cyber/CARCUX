# Copy to backend/.env for local development. Never commit .env.
CARCUX_ENVIRONMENT=development
CARCUX_DATABASE_URL=postgresql+psycopg://carcux:carcux@localhost:5432/carcux
CARCUX_REDIS_URL=redis://localhost:6379/0
CARCUX_CORS_ORIGINS=["http://localhost:3000"]

# Required in production: 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CARCUX_JWT_SECRET=
CARCUX_ACCESS_TOKEN_MINUTES=30
