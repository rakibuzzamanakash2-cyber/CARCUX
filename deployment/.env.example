# Copy to deployment/.env (next to docker-compose.yml: Compose reads .env from there)
# and fill in. deployment/.env is ignored by git; never commit it.

# Dataset export: salt for the hashed references to social media accounts. Generate once,
# e.g. in PowerShell:  [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
# and never change it afterwards, or the same account gets a new reference.
CARCUX_DATASET_SALT=

# Optional: an approved ReliefWeb app name (https://apidoc.reliefweb.int), then enable
# ReliefWeb on the Sources page.
CARCUX_RELIEFWEB_APPNAME=
